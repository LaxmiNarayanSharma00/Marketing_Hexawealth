# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# Sessions (cookies — never commit)
data/sessions/*.json
!data/sessions/.gitkeep

# Sources
data/sources/*.json
!data/sources/.gitkeep

# Automations + profiles + engagements + schedules
data/automations/*.json
!data/automations/.gitkeep
data/profiles/*.json
!data/profiles/.gitkeep
data/engagements/*.json
!data/engagements/.gitkeep
data/schedules/*.json
!data/schedules/.gitkeep

# SQLite (sessions/cookies + all durable state — never commit)
data/*.db
data/*.db-wal
data/*.db-shm

# Env / OS
.env
.DS_Store
*.log
